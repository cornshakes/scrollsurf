# Copy this file to .env.local / .env.test / .env.prod and fill in the values.
# All three are gitignored; this file is the only one that is committed.

# ── All environments ─────────────────────────────────────────────────────────

# Absolute path to the directory where scrollsurf.db and datasets/ live.
# Dev default: the repo root (.)
SCROLLSURF_DATA_DIR=.

# Optional: fraction of feed items that are pictures (0–1, default 0.2)
# FEED_PICTURE_RATIO=0.2

# Optional: strength of topic-affinity feed weighting (default 2.0); 0 = pure random
# FEED_AFFINITY_STRENGTH=2.0

# ── Test + prod (Pi deploys) ─────────────────────────────────────────────────

# SSH target for the Pi (used by scripts/deploy.ts and the docker context)
PI_SSH=pi@raspberrypi.local

# Host path on the Pi to mount as /data inside the container
DATA_DIR_HOST=/srv/scrollsurf/test   # use /srv/scrollsurf/prod in .env.prod

# Port exposed on the Pi for LAN access (test only; prod uses Tailscale Funnel)
TEST_PORT=3001

# ── Prod only ────────────────────────────────────────────────────────────────

# Tailscale reusable auth key tagged tag:scrollsurf (from admin.tailscale.com → Keys)
TS_AUTHKEY=tskey-auth-REPLACE_ME

# Tailscale hostname — becomes https://<TS_HOSTNAME>.<tailnet>.ts.net
TS_HOSTNAME=scrollsurf
