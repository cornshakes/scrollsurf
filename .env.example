# Copy this file to .env.local / .env.test / .env.prod and fill in the values.
# All three are gitignored; this file is the only one that is committed.

# ── All environments ─────────────────────────────────────────────────────────

# Absolute path to the directory where scrollsurf.db and datasets/ live.
# Dev default: the repo root (.)
SCROLLSURF_DATA_DIR=.

# SMTP settings for login code emails. Leave unset in dev to log codes to the console instead.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-email@example.com
# SMTP_PASS=your-app-password
# SMTP_FROM=noreply@example.com

# ── Test + prod (remote deploys) ─────────────────────────────────────────────

# SSH target for the deploy host: the Pi for test, the box for prod
SSH_HOST=pi

# Docker context for the deploy host (docker context ls) — usually the same name
DOCKER_CONTEXT=pi

# Host path on the deploy host to mount as /data inside the container
# use /srv/scrollsurf/prod in .env.prod
DATA_DIR_HOST=/srv/scrollsurf/test

# Port exposed on the Pi for LAN access (test only; prod is served by box-caddy)
TEST_PORT=3001
