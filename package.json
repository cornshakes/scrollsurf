{
  "name": "scrollsurf",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "check": "tsc --noEmit && eslint",
    "deploy:test": "tsx scripts/deploy.ts up test",
    "deploy:prod": "tsx scripts/deploy.ts up prod",
    "pi:logs:test": "tsx scripts/deploy.ts logs test",
    "pi:logs:prod": "tsx scripts/deploy.ts logs prod",
    "pi:funnel": "tsx scripts/deploy.ts funnel prod",
    "pi:down:test": "tsx scripts/deploy.ts down test",
    "pi:down:prod": "tsx scripts/deploy.ts down prod",
    "lint-fix": "eslint --fix",
    "test:e2e:setup": "playwright install chromium",
    "test:e2e:create-db": "tsx scripts/create-e2e-db.ts",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "test:e2e:ui": "playwright test --ui",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "coverage:open": "open coverage/lcov-report/index.html",
    "download-vital-50000": "tsx scripts/datasets/download-vital-50000.ts",
    "download-unusual": "tsx scripts/datasets/download-unusual.ts",
    "download-good-articles": "tsx scripts/datasets/download-good-articles.ts",
    "download-featured-articles": "tsx scripts/datasets/download-featured-articles.ts",
    "download-featured-pictures": "tsx scripts/datasets/download-featured-pictures.ts",
    "download-commons-featured-pictures": "tsx scripts/datasets/download-commons-featured-pictures.ts",
    "categorize": "tsx scripts/categorize.ts"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.0.1",
    "@mui/material": "^9.0.1",
    "@mui/material-nextjs": "^9.0.1",
    "next": "16.2.9",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-intersection-observer": "^9"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.19.19",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "entities": "^4",
    "es-toolkit": "^1",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jest": "^30.4.2",
    "ky": "^1",
    "prettier": "^3.8.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "wtf_wikipedia": "^10"
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "trailingComma": "es5",
    "printWidth": 100,
    "tabWidth": 2,
    "useTabs": false,
    "arrowParens": "always",
    "endOfLine": "lf"
  },
  "overrides": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3"
  }
}
